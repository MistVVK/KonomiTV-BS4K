
# config.yaml: ホスト側のファイルを利用するため不要
config.yaml

# node_modules: ファイル数が多すぎてコピーに時間がかかる
client/node_modules/

# poetry の仮想環境: Docker 上で新たに作り直すため不要
server/.venv/

# 自動テスト: Git とローカル検証で利用し、Docker のビルドコンテキスト・実行イメージには含めない
server/tests/
client/scripts/*.test.mjs

# Python のテスト・実行時キャッシュ: ホスト環境の生成物をコンテナへ持ち込まない
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.ruff_cache/

# データベース: マイグレーションに失敗するのを防ぐ
server/data/*

# サードパーティーライブラリ: Docker 側でファイルを準備するため不要
server/thirdparty/

# tsreadex: Docker の builder stage でコンテナ環境向けにビルドする
thirdparty-src/tsreadex/tsreadex.elf
