# FFmpeg 8 / Hardware SDK headers
# ソース依存は commit / tag とバージョン入り URL で固定する。
# commit 固定された git 内容や Git 管理下の patch の checksum 照合は冗長で
# 保守時の churn 元になるため行わない (URL ダウンロード物の SHA-256 は唯一の完全性検証なので残す)。
FFMPEG8_VERSION=8.1.2
FFMPEG8_TAG=n8.1.2
FFMPEG8_REPOSITORY=https://github.com/FFmpeg/FFmpeg.git
FFMPEG8_COMMIT=38b88335f99e76ed89ff3c93f877fdefce736c13
FFMPEG_LIBARIBTLV_REPOSITORY=https://github.com/makeding/ffmpeg-libaribtlv.git
FFMPEG_LIBARIBTLV_COMMIT=29cc14822fae9cb8cd06bbfdd584d06aa7a6a1fa
LIBARIBTLV_VERSION=0.2.0
LIBARIBTLV_TAG=v0.2.0
LIBARIBTLV_REPOSITORY=https://github.com/makeding/libaribtlv.git
LIBARIBTLV_COMMIT=91bafe32479141c660a334cc03aed1f9869a18a5
# FFmpeg は 0.2.0 + subtitle patch のまま。B60 / MH-EIT 色ヒントは
# 未タグの master を metadata helper だけが参照する。
LIBARIBTLV_SI_COMMIT=3374e2c1d70202d8ff782ec0b0cb27ecb95e6ce3
NVCODEC_HEADERS_VERSION=12.1.14.0
