# ホストのユーザー・GPUデバイスに合わせて変更してください。
KONOMITV_UID=1000
KONOMITV_GID=1000
KONOMITV_VIDEO_GID=44
KONOMITV_RENDER_GID=109

# 使用する GPU にあわせてどれか一つをコメントアウトを外してください
#GPUなし
COMPOSE_FILE=compose.yaml
#Intel GPU
#COMPOSE_FILE=compose.yaml:compose.intel.yaml
#AMD GPU
#COMPOSE_FILE=compose.yaml:compose.amd.yaml
#NVIDIA GPU
#COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
#Intel GPU と NVIDIA GPU の併用
#COMPOSE_FILE=compose.yaml:compose.intel.yaml:compose.nvidia.yaml
#AMD GPU と NVIDIA GPU の併用
#COMPOSE_FILE=compose.yaml:compose.amd.yaml:compose.nvidia.yaml
#Intel GPU と AMD GPU の併用（後述の KONOMITV_INTEL_NONFREE / KONOMITV_AMD_NONFREE を両方 true に明示が必要です）
#COMPOSE_FILE=compose.yaml:compose.intel.yaml:compose.amd.yaml
# 移行: bs4k-v1.1.3 以前の .env.example にあった compose.intel-amd.yaml は廃止されました。
# COMPOSE_FILE に compose.intel-amd.yaml を設定している場合は、上記の
# compose.intel.yaml:compose.amd.yaml への書き換えが必要です（書き換えないと docker compose が失敗します）

# Dockerイメージへ組み込むCUDAと非自由コンポーネントの構成です。
# RTX50以降の場合は12.8指定
KONOMITV_CUDA_VERSION=12.4
# 非自由コンポーネントのプロファイル（nonfree / free。再配布可否側面のみを表す）
# 実際に何を含むかは下記の vendor flag が決めます。GPU overlay を使う場合は overlay 既定が先行し、この値は通常空で構いません。
# nonfree: 再配布不可側プロファイル。ベンダーフラグが未指定のベンダーは含みません（警告が出ます。含む側は true を明示）
# free:    再配布可能プロファイル。ベンダーフラグの true 指定はビルドエラー（未指定は含めない = false と同じ。Intel/AMD の HEVC HWENCODE は不可、NVIDIA はホスト側ランタイムで利用可）
# 互換のため true（=nonfree）/ false（=free）も受け付けます。intel-nonfree / amd-nonfree は廃止され、指定するとビルドエラーです
#KONOMITV_NONFREE=
# Intel 非自由カーネル（Full Feature iHD）を含めるか（true / false / 未指定=含めない）。GPU overlay を使う場合は overlay の既定が先行します
#KONOMITV_INTEL_NONFREE=
# AMD proprietary runtime を含めるか（true / false / 未指定=含めない）。GPU overlay を使う場合は overlay の既定が先行します
#KONOMITV_AMD_NONFREE=

# Intel / AMD GPU の DRM render node です。空なら /dev/dri/ 全体を渡して自動選択します。
# 特定の GPU だけを使う場合は /dev/dri/renderD128 のように render node を指定してください。
# Intel GPU と AMD GPU を併用する場合に片方だけ指定すると、もう片方は既定値（/dev/dri/ 全体）で渡されます。
KONOMITV_INTEL_DRI_DEVICE=
KONOMITV_AMD_DRI_DEVICE=

# Google Vertex AIを利用する場合に設定してください。
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
