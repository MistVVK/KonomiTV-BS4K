diff --git a/node_modules/aribb24.js/src/utils/jis-x0213.ts b/node_modules/aribb24.js/src/utils/jis-x0213.ts
new file mode 100644
index 0000000..2d34606
--- /dev/null
+++ b/node_modules/aribb24.js/src/utils/jis-x0213.ts
@@ -0,0 +1,19 @@
+const EUC_JP_DECODER = new TextDecoder('euc-jp', { fatal: true })
+
+/**
+ * 7ビットの区点コードで表現された JIS X 0213:2004 の漢字を Unicode へ変換する。
+ * 第1面は EUC-JP の2バイト、第2面は SS3 に続く3バイトとして復号する。
+ */
+export default function decodeJISX0213Character(key: number, plane: 1 | 2): string | null {
+  const row = ((key >> 8) & 0x7F) | 0x80
+  const cell = (key & 0x7F) | 0x80
+  const bytes = plane === 1
+    ? Uint8Array.from([row, cell])
+    : Uint8Array.from([0x8F, row, cell])
+
+  try {
+    return EUC_JP_DECODER.decode(bytes)
+  } catch {
+    return null
+  }
+}
