# KonomiTV-BS4K TS Codec Bridge の取得元と再現可能な builder toolchain。
# SOURCE_COMMIT / SOURCE_ARCHIVE_SHA256 は公開済み Bridge commit の codeload archive に固定する。
KONOMITV_BS4K_TSCODECBRIDGE_REPOSITORY_OWNER=MistVVK
KONOMITV_BS4K_TSCODECBRIDGE_REPOSITORY_NAME=KonomiTV-BS4K-TSCodecBridge
KONOMITV_BS4K_TSCODECBRIDGE_SOURCE_COMMIT=5dadc840332ca2c35318fd59ec5553427843a436
KONOMITV_BS4K_TSCODECBRIDGE_SOURCE_ARCHIVE_SHA256=ddb50ae0d6e77d7be2fd7bbd4c7811b910c365eeb2f5f95bedbfcb188e63e9d2
KONOMITV_BS4K_TSCODECBRIDGE_CLI_VERSION=0.1.0
KONOMITV_BS4K_TSCODECBRIDGE_TS_MAPPING_VERSION=1

# builder はこの digest の Ubuntu 22.04 と、公式 Jammy archive の package だけを使う。
KONOMITV_BS4K_TSCODECBRIDGE_UBUNTU_CODENAME=jammy
KONOMITV_BS4K_TSCODECBRIDGE_UBUNTU_IMAGE_SHA256=0e0a0fc6d18feda9db1590da249ac93e8d5abfea8f4c3c0c849ce512b5ef8982
KONOMITV_BS4K_TSCODECBRIDGE_CA_CERTIFICATES_PACKAGE_VERSION=20260601~22.04.1
KONOMITV_BS4K_TSCODECBRIDGE_CURL_PACKAGE_VERSION=7.81.0-1ubuntu1.25
KONOMITV_BS4K_TSCODECBRIDGE_MAKE_PACKAGE_VERSION=4.3-4.1build1
KONOMITV_BS4K_TSCODECBRIDGE_TAR_PACKAGE_VERSION=1.34+dfsg-1ubuntu0.1.22.04.6
KONOMITV_BS4K_TSCODECBRIDGE_NALA_PACKAGE_VERSION=0.11.1~bpo22.04.1
KONOMITV_BS4K_TSCODECBRIDGE_SBCL_PACKAGE_VERSION=2:2.1.11-1
KONOMITV_BS4K_TSCODECBRIDGE_CL_SWANK_PACKAGE_VERSION=2:2.26.1+dfsg-2
KONOMITV_BS4K_TSCODECBRIDGE_LIBC6_PACKAGE_VERSION=2.35-0ubuntu3.14
KONOMITV_BS4K_TSCODECBRIDGE_LIBC6_PACKAGE_SHA256=4aa2feae34cb6296e133af5c7429756ab5606549cd16a9d26a0060e010214523
KONOMITV_BS4K_TSCODECBRIDGE_ZLIB1G_PACKAGE_VERSION=1:1.2.11.dfsg-2ubuntu9.2
KONOMITV_BS4K_TSCODECBRIDGE_ZLIB1G_PACKAGE_SHA256=9dc17e51a1be2d9ed63b7b84ef0e4e29c5abe6f1bc62cb03e7181483cce8a2f2

# lint tool は builder だけへ固定 archive として取得し、最終 image へは移さない。
KONOMITV_BS4K_TSCODECBRIDGE_SBLINT_COMMIT=1037296f604c3210ce073a53539d4ae95b0c2f8c
KONOMITV_BS4K_TSCODECBRIDGE_SBLINT_SOURCE_SHA256=4d7eec72c1322fd16dc444eb62a7981111965bfce72bf6161bf69e2a6786fd3e
KONOMITV_BS4K_TSCODECBRIDGE_MALLET_VERSION=0.9.2
KONOMITV_BS4K_TSCODECBRIDGE_MALLET_ARCHIVE_SHA256=95d28cc93bf22dd529ea084073478047edb59e690a1a029b85bfbe5579930808

# thirdparty-builder が生成した固定 FFmpeg 8.1.2 だけを Bridge 統合試験へ渡す。
KONOMITV_BS4K_TSCODECBRIDGE_FFMPEG_VERSION=n8.1.2
KONOMITV_BS4K_TSCODECBRIDGE_FFMPEG_BINARY_SHA256=5599c2bc61d987c7336ad4a7bf4b917fa8b260822fbb65c8b069188931339f76
KONOMITV_BS4K_TSCODECBRIDGE_FFPROBE_BINARY_SHA256=877ca4ba5b63cabde0378cb39af3be12e449b6079c2d975b37aaab20f758c191
