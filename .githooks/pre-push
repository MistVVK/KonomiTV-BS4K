#!/usr/bin/env bash

set -euo pipefail

repository_root="$(git rev-parse --show-toplevel)"

if ! command -v poetry > /dev/null 2>&1; then
    echo '[pre-push] Poetry is required to run the server lint.' >&2
    exit 1
fi
if command -v yarn > /dev/null 2>&1; then
    yarn_command=(yarn)
elif command -v corepack > /dev/null 2>&1; then
    yarn_command=(corepack yarn)
else
    echo '[pre-push] Yarn or Corepack is required to run the client typecheck.' >&2
    exit 1
fi

echo '[pre-push] Running server lint...'
(
    cd "${repository_root}/server"
    poetry run task lint
)

echo '[pre-push] Running client typecheck...'
(
    cd "${repository_root}/client"
    "${yarn_command[@]}" typecheck
)

echo '[pre-push] Static checks passed.'
