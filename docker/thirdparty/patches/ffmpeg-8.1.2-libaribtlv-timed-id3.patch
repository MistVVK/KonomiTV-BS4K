+static int libaribtlv_timed_id3_track_index(const LibaribtlvContext *ctx,
+                                            uint64_t id)
+{
+    size_t i;
+
+    for (i = 0; i < ctx->track_count; i++) {
+        if (ctx->tracks[i].id == id)
+            return ctx->tracks[i].timed_id3_stream_index;
+    }
+    return -1;
+}
+
+static void libaribtlv_set_timed_id3_track_index(LibaribtlvContext *ctx,
+                                                  uint64_t id, int stream_index)
+{
+    size_t i;
+
+    for (i = 0; i < ctx->track_count; i++) {
+        if (ctx->tracks[i].id == id) {
+            ctx->tracks[i].timed_id3_stream_index = stream_index;
+            return;
+        }
+    }
+}
+
+static int libaribtlv_queue_packet(LibaribtlvContext *ctx, AVPacket *packet)
+{
+    LibaribtlvPacket *queued = av_mallocz(sizeof(*queued));
+
+    if (!queued) {
+        av_packet_free(&packet);
+        return AVERROR(ENOMEM);
+    }
+    queued->packet = packet;
+    if (ctx->queue_tail)
+        ctx->queue_tail->next = queued;
+    else
+        ctx->queue_head = queued;
+    ctx->queue_tail = queued;
+    return 0;
+}
