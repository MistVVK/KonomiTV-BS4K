# Native utilities
# TSREADEX_SOURCE_SHA256 は Docker build context では submodule の Git metadata が
# 除外されるため、固定 commit の tracked source tree と同じ内容かを検証する pin の実効部。
TSREADEX_COMMIT=3dde76d4c954f74247fd5cacdc2624dc3b9045b5
