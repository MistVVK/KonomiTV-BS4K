+static void libaribtlv_write_synchsafe(uint8_t *destination, uint32_t value)
+{
+    destination[0] = (value >> 21) & 0x7f;
+    destination[1] = (value >> 14) & 0x7f;
+    destination[2] = (value >> 7) & 0x7f;
+    destination[3] = value & 0x7f;
+}
+
+static void libaribtlv_on_subtitle_mfu(void *opaque,
+                                       const aribtlv_subtitle_mfu *mfu)
+{
+    LibaribtlvContext *ctx = opaque;
+    static const char owner[] = ARIBTLV_ID3_OWNER;
+    const size_t owner_size = sizeof(owner) - 1;
+    AVStream *st;
+    AVRational source_time_base;
+    uint64_t pts_90khz;
+    size_t fragment_count;
+    size_t fragment_index;
+    size_t fragment_offset;
+    int stream_index;
+
+    if (ctx->fatal_error || ctx->seek_probe)
+        return;
+    if (mfu->size < 4 || mfu->size > UINT32_MAX ||
+        mfu->additional_data_component_info_size > UINT16_MAX)
+        return;
+
+    stream_index = libaribtlv_timed_id3_track_index(ctx, mfu->track_id);
+    if (stream_index < 0)
+        return;
+    st = ctx->format->streams[stream_index];
+    source_time_base = (AVRational) {
+        1, mfu->pts.timescale ? mfu->pts.timescale : 1
+    };
+    pts_90khz = (uint64_t)av_rescale_q(mfu->pts.value, source_time_base,
+                                       (AVRational){ 1, 90000 }) &
+                ((UINT64_C(1) << 33) - 1);
+    fragment_count = (mfu->size + ARIBTLV_ID3_MAX_RAW_FRAGMENT - 1) /
+                     ARIBTLV_ID3_MAX_RAW_FRAGMENT;
+    if (!fragment_count || fragment_count > UINT16_MAX)
+        return;
+
+    for (fragment_index = 0, fragment_offset = 0;
+         fragment_index < fragment_count;
+         fragment_index++, fragment_offset += ARIBTLV_ID3_MAX_RAW_FRAGMENT) {
+        const size_t fragment_size = FFMIN(ARIBTLV_ID3_MAX_RAW_FRAGMENT,
+                                           mfu->size - fragment_offset);
+        const size_t frame_payload_size = owner_size + 1 +
+                                          ARIBTLV_ID3_ENVELOPE_SIZE +
+                                          mfu->additional_data_component_info_size +
+                                          fragment_size;
+        const size_t tag_payload_size = 10 + frame_payload_size;
+        const size_t packet_size = 10 + tag_payload_size;
+        AVPacket *packet;
+        uint8_t *cursor;
+        int ret;
+
+        if (frame_payload_size > 0x0fffffff ||
+            tag_payload_size > 0x0fffffff || packet_size > INT_MAX) {
+            ctx->fatal_error = AVERROR_INVALIDDATA;
+            return;
+        }
+        packet = av_packet_alloc();
+        if (!packet) {
+            ctx->fatal_error = AVERROR(ENOMEM);
+            return;
+        }
+        ret = av_new_packet(packet, packet_size);
+        if (ret < 0) {
+            av_packet_free(&packet);
+            ctx->fatal_error = ret;
+            return;
+        }
+
+        cursor = packet->data;
+        memcpy(cursor, "ID3", 3);
+        cursor[3] = 4;
+        cursor[4] = 0;
+        cursor[5] = 0;
+        libaribtlv_write_synchsafe(cursor + 6, tag_payload_size);
+        cursor += 10;
+        memcpy(cursor, "PRIV", 4);
+        libaribtlv_write_synchsafe(cursor + 4, frame_payload_size);
+        cursor[8] = 0;
+        cursor[9] = 0;
+        cursor += 10;
+        memcpy(cursor, owner, owner_size);
+        cursor += owner_size;
+        *cursor++ = 0;
+        *cursor++ = ARIBTLV_ID3_PAYLOAD_VERSION;
+        *cursor++ = mfu->component_tag & 0xff;
+        memcpy(cursor, mfu->data, 4);
+        cursor += 4;
+        AV_WB16(cursor, mfu->additional_data_component_info_size);
+        cursor += 2;
+        AV_WB16(cursor, fragment_index);
+        cursor += 2;
+        AV_WB16(cursor, fragment_count);
+        cursor += 2;
+        AV_WB32(cursor, mfu->size);
+        cursor += 4;
+        AV_WB32(cursor, fragment_offset);
+        cursor += 4;
+        AV_WB64(cursor, pts_90khz);
+        cursor += 8;
+        if (mfu->additional_data_component_info_size)
+            memcpy(cursor, mfu->additional_data_component_info,
+                   mfu->additional_data_component_info_size);
+        cursor += mfu->additional_data_component_info_size;
+        memcpy(cursor, mfu->data + fragment_offset, fragment_size);
+
+        source_time_base.den = mfu->pts.timescale ? mfu->pts.timescale : 1;
+        packet->pts = av_rescale_q(mfu->pts.value, source_time_base,
+                                   st->time_base);
+        source_time_base.den = mfu->dts.timescale ? mfu->dts.timescale : 1;
+        packet->dts = av_rescale_q(mfu->dts.value, source_time_base,
+                                   st->time_base);
+        packet->stream_index = stream_index;
+        packet->pos = mfu->input_offset <= INT64_MAX ? mfu->input_offset : -1;
+        packet->flags |= AV_PKT_FLAG_KEY;
+        ret = libaribtlv_queue_packet(ctx, packet);
+        if (ret < 0) {
+            ctx->fatal_error = ret;
+            return;
+        }
+    }
 }
 
